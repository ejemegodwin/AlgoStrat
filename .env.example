DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET_KEY="replace-with-a-generated-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Platform fee taken from each milestone accrual, in percent (ADR-009).
# 0 while no payment rails exist; the worker receives amount minus fee.
PLATFORM_FEE_PERCENT=0

# Payment provider adapter (ADR-012): simulated until a real
# provider (Stripe/Paystack) is configured for a registered business.
PAYMENT_PROVIDER=simulated

# Comma-separated origins allowed to call the API from a browser
# (ADR-013). The Vite dev server is the default; add the deployed
# frontend origin in production. Never "*".
CORS_ORIGINS=http://localhost:5173

# Server-side key for signing work receipts (HMAC-SHA256). Completion
# of a contract fails cleanly (503) if this is unset — a verified
# completion must always produce its receipt. Generate a long random
# value per environment; rotating it makes old receipts verify as
# "invalid", so treat it as permanent once receipts exist.
RECEIPT_SIGNING_KEY="replace-with-a-generated-signing-key"
